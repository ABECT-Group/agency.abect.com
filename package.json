{
  "name": "agency-abect",
  "version": "2.1.0",
  "description": "ABECT agency website: Next.js + Payload CMS (agency.abect.com)",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "pl": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:services": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-services.ts",
    "seed:services:extra": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-services-extra.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.544.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-type-animation": "^3.2.0",
    "sass": "^1.86.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.4.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "picomatch": "^4.0.3",
    "yaml": "^2.8.2",
    "happy-dom": "21.0.4",
    "dompurify": "3.4.17",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "private": true
}
